{
  "name": "runas-de-la-cuadricula",
  "private": true,
  "description": "Juego para aprender CSS escribiéndolo: los fundamentos en la Isla del Aprendiz, Grid en la superficie, Flexbox bajo tierra y, en los cielos, media queries, variables y transiciones.",
  "keywords": [
    "css",
    "css-grid",
    "flexbox",
    "media-queries",
    "custom-properties",
    "css-transitions",
    "aprender-css",
    "juego-educativo",
    "react",
    "vite"
  ],
  "homepage": "https://quiqueorg.github.io/runas-de-la-cuadricula/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quiqueorg/runas-de-la-cuadricula.git"
  },
  "bugs": {
    "url": "https://github.com/quiqueorg/runas-de-la-cuadricula/issues"
  },
  "author": "Quique",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:lessons": "node scripts/check-lessons.mjs",
    "check": "tsc --noEmit && node scripts/check-lessons.mjs && vite build",
    "music": "node scripts/render-kalimba.mjs",
    "isle-map": "node scripts/render-isle.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  }
